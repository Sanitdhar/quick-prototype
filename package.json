{
  "name": "quick-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Brainstorm product ideas, spin up quick prototypes, lift-and-shift the ones that stick.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "check:py": "bash scripts/py-check.sh",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:py",
    "new": "bash scripts/new-prototype.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  }
}
